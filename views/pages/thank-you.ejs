<%
/*
  Ported from storefront-lamp/theme/templates/pages/thank-you.twig, styled per
  docs/mockup/mockup/intake/thankyou.html. `receipt` is the ReceiptViewModel `Completion.complete()`
  assembled — every figure is frozen at the moment the journey completed, never re-derived here.

  Omitted from the mockup, since this port has nothing backing them: a case id (`ReceiptViewModel`
  deliberately carries none — the EMR's treatment record has a null `provider_case_id` at creation
  time, so there is nothing true to print yet), the delivery map, a separate billing address
  (`[13.2]`: billing = shipping, one address only), and a shipping method/cost line (no shipping
  selector in this port — `config/app.ts`'s declared `shippingSelector: false` gap).

  `line_images` (slug -> photo) is resolved by `ReceiptController` at render time, deliberately not
  part of the frozen `ReceiptViewModel` snapshot — a receipt outlives the catalog it was bought from.
*/
%>
<%- include('../partials/head', { page_title: 'Order Confirmed', page_description: null, noindex: true }) %>

<header class="border-b border-border bg-background">
  <div class="mx-auto flex h-20 max-w-[1260px] items-center px-6 lg:px-16">
    <a href="<%= url('/') %>" class="shrink-0" aria-label="AsterMD home"><%- include('../partials/logo') %></a>
  </div>
</header>

<main class="lg:grid lg:grid-cols-2 lg:gap-x-10">
  <div class="px-6 py-10 sm:px-10 lg:py-14 lg:pl-24 lg:pr-0">
    <div class="mx-auto max-w-[500px] flex flex-col gap-6 lg:mx-0 lg:ml-auto">

      <% if (!receipt.hasOrder()) { %>
      <div class="flex items-center gap-4">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-border">
          <i data-lucide="receipt" class="size-5 text-icon-muted"></i>
        </span>
        <h1 class="font-heading text-[24px] font-bold text-heading sm:text-[28px]">No recent order found</h1>
      </div>
      <p class="text-sm leading-6 text-body">We couldn't find an order on this session. If you just completed checkout, check your email for a confirmation.</p>
      <% } else { %>

      <div class="flex items-center gap-4">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-primary">
          <i data-lucide="check" class="size-5 text-primary" stroke-width="3"></i>
        </span>
        <div>
          <% if (receipt.orderNumber) { %><p class="text-sm text-muted">Order #<%= receipt.orderNumber %></p><% } %>
          <h1 class="font-heading text-[24px] font-bold text-heading sm:text-[28px]">Thank you<% if (receipt.buyerFirstName) { %>, <%= receipt.buyerFirstName %><% } %>!</h1>
        </div>
      </div>

      <div class="rounded-lg border border-border bg-background p-6">
        <h2 class="font-heading text-base font-medium sm:text-lg text-heading">Intake Received &amp; Pending Review</h2>
        <p class="mt-3 text-sm leading-6 text-body">
          We've received your submission and placed your order on hold. Our licensed physician is currently reviewing your health information to see if this treatment is right for you.
        </p>
        <% if (post_checkout_steps) { %>
        <%- include('../partials/post-checkout-steps', { note_class: 'mt-6 text-left' }) %>
        <% } %>
        <% if (portal_url) { %>
        <a href="<%= portal_url %>" class="mt-6 inline-flex h-[41px] w-full items-center justify-center gap-2 rounded-sm bg-primary px-5 text-base font-medium text-primary-foreground transition-colors hover:bg-primary-hover">
          Go to Patient Portal
          <i data-lucide="arrow-right" class="size-[14px]"></i>
        </a>
        <% } %>
      </div>

      <div class="rounded-lg border border-border bg-background p-6">
        <h2 class="font-heading text-base font-medium sm:text-lg text-heading">What happens next?</h2>

        <div class="mt-5 flex flex-col gap-5">
          <div>
            <div class="flex items-center gap-2">
              <p class="text-base font-medium text-heading">Provider / Doctor Review</p>
              <span class="inline-flex items-center gap-1 rounded-full bg-warning-light px-2.5 py-1 text-xs font-medium text-warning">
                <i data-lucide="hourglass" class="size-3"></i>
                In Progress
              </span>
            </div>
            <div class="mt-3 flex items-start gap-3">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-warning-light">
                <i data-lucide="user-search" class="size-4 text-warning"></i>
              </span>
              <p class="mt-1.5 text-sm leading-6 text-body">Our clinical team is currently reviewing your intake forms and health information. This typically takes 24-48 hours.</p>
            </div>
          </div>

          <div>
            <div class="flex items-center gap-2">
              <p class="text-base font-medium text-heading">Prescription &amp; Delivery</p>
              <span class="inline-flex items-center gap-1 rounded-full bg-surface px-2.5 py-1 text-xs font-medium text-muted">
                <i data-lucide="circle-pause" class="size-3"></i>
                On Hold
              </span>
            </div>
            <div class="mt-3 flex items-start gap-3">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-surface">
                <i data-lucide="truck" class="size-4 text-icon-muted"></i>
              </span>
              <p class="mt-1.5 text-sm leading-6 text-body">If approved, your prescription will be sent to our pharmacy and shipped discreetly to your address. If additional information is needed, your doctor will message you.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-border bg-background p-6">
        <h2 class="font-heading text-base font-medium sm:text-lg text-heading">Order details</h2>

        <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <p class="text-sm font-medium text-heading">Contact information</p>
            <% if (receipt.buyerEmail) { %><p class="mt-3 text-sm text-body"><%= receipt.buyerEmail %></p><% } %>
            <% if (receipt.buyerPhone) { %><p class="mt-1 text-sm text-body"><%= receipt.buyerPhone %></p><% } %>
          </div>
          <% if (receipt.cardLastFour) { %>
          <div>
            <p class="text-sm font-medium text-heading">Payment method</p>
            <p class="mt-3 text-sm text-body">Card ending in <%= receipt.cardLastFour %></p>
          </div>
          <% } %>

          <% if (receipt.shippingAddress) { %>
          <div>
            <p class="text-sm font-medium text-heading">Shipping address</p>
            <p class="mt-3 text-sm leading-6 text-body">
              <% if (receipt.buyerName) { %><%= receipt.buyerName %><br /><% } %>
              <%= receipt.shippingAddress %>
            </p>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <% if (receipt.hasOrder()) { %>
  <div class="border-border bg-background-2 px-6 py-10 sm:px-10 lg:border-l lg:px-12 lg:py-14">
    <div class="mx-auto max-w-[410px] lg:mx-0 lg:sticky lg:top-10">

      <div class="flex flex-col gap-4">
        <% receipt.lines.forEach(function (line) { %>
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            <% if (line_images[line.slug]) { %><img src="<%= line_images[line.slug] %>" alt="<%= line.name %>" class="size-14 rounded-sm object-cover" />
            <% } else { %><span class="flex size-14 items-center justify-center rounded-sm bg-surface"><i data-lucide="pill" class="size-6 text-icon-muted"></i></span><% } %>
            <span class="absolute -right-1.5 -top-1.5 flex size-5 items-center justify-center rounded-full bg-heading text-xs font-medium text-background"><%= line.quantity %></span>
          </div>
          <div class="flex-1">
            <p class="text-sm text-heading"><%= line.name %></p>
          </div>
          <p class="shrink-0 text-base font-medium text-heading"><%= line.line_total_cents === 0 ? 'Free' : money(line.line_total_cents) %></p>
        </div>
        <% }) %>
      </div>

      <div class="mt-6 flex flex-col gap-2 border-t border-border pt-6 text-sm text-heading">
        <div class="flex items-center justify-between">
          <span>Subtotal &bull; <%= receipt.itemCount %> item<%= receipt.itemCount === 1 ? '' : 's' %></span>
          <span><%= money(receipt.subtotalCents) %></span>
        </div>
        <% if (receipt.hasDiscount()) { %>
        <div class="flex items-center justify-between text-primary">
          <span>Discount<% if (receipt.promotionCode) { %> (<%= receipt.promotionCode %>)<% } %></span>
          <span>&minus;<%= money(receipt.discountCents) %></span>
        </div>
        <% } %>
      </div>
      <div class="mt-4 flex items-center justify-between border-t border-border pt-4">
        <span class="text-base font-medium sm:text-lg text-heading">Total</span>
        <span class="text-base font-medium sm:text-lg text-heading"><span class="mr-1 text-sm font-normal text-muted align-middle"><%= receipt.currency %></span><%= money(receipt.paidTotalCents) %></span>
      </div>

      <div class="mt-6 flex items-start gap-3 rounded-sm border border-primary bg-primary-light px-4 py-4">
        <i data-lucide="info" class="mt-0.5 size-5 shrink-0 text-primary"></i>
        <p class="text-sm leading-relaxed text-heading">
          <% if (receipt.authorizedOnly) { %>
          Your card has been authorized for <%= money(receipt.paidTotalCents) %>, but you will not be charged unless your prescription is approved by a doctor.
          <% } else { %>
          Your card has been charged <%= money(receipt.paidTotalCents) %>. Your order is on hold pending physician review.
          <% } %>
        </p>
      </div>
    </div>
  </div>
  <% } %>
</main>

<%- include('../partials/footer-compliance') %>
<%- include('../partials/foot') %>
