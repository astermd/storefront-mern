<%
/*
  Ported from storefront-lamp/theme/templates/pages/checkout.twig, styled per
  docs/mockup/mockup/intake/checkout.html (the two-column contact/delivery/payment form beside a
  sticky order summary). `checkout` is the CheckoutViewModel `CheckoutController` assembled —
  every price, every offer and every consent control is resolved server-side; this template does
  no pricing of its own.

  The mockup's plan-selector/shipping/express-checkout/PayPal/Afterpay/upsell-add-on sections are
  presentational mockup content with no backing service yet in this port (shipping/wallets are
  declared gaps in `config/app.ts`'s `features` block; upsell add-ons are Phase 8) — omitted here
  rather than wired to nothing. What IS wired: contact + delivery (the 8 BuyerDetails fields), an
  optional separate billing address (the `billing_*` fields, read only when its box is ticked),
  the Rx plan selector when the cart has a prescription line, order bumps (§27), a discount code
  box, the line-item/consent/totals summary, and the card fields the adapter's capabilities call for.
*/
const errors = checkout.errors || {};
const prefill = checkout.prefill || {};
function fieldError(name) { return errors[name] || null; }
const addressAutocomplete = typeof address_autocomplete === 'undefined' ? null : address_autocomplete;
function esc(value) { return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
const clientConfig = checkout.capabilities.clientConfig || {};
const providerHosted = !checkout.capabilities.rendersOwnCardFields();
// A provider that hosts its own card fields declares its script, which has to come from the provider;
// `payment-<provider>.js` is this theme's glue between that script and the form. Deferred like
// everything else here, so the three run in this order.
let providerScripts = '';
if (providerHosted && Object.keys(clientConfig).length > 0) {
  if (clientConfig.script) { providerScripts += '<script src="' + esc(clientConfig.script) + '" defer></script>'; }
  providerScripts += '<script src="' + esc(asset('payment-' + checkout.capabilities.providerCategory + '.js')) + '" defer></script>';
}
const scripts = '<script src="' + asset('checkout.js') + '" defer></script>' + providerScripts + (addressAutocomplete ? '<script src="' + asset('address-autocomplete.js') + '" defer></script>' : '');
%>
<%- include('../partials/head', { page_title: 'Checkout', page_description: null, noindex: true }) %>

<header class="border-b border-border bg-background">
  <div class="mx-auto flex h-20 max-w-[1260px] items-center px-6 lg:px-16">
    <a href="<%= url('/') %>" class="shrink-0" aria-label="AsterMD home">
      <%- include('../partials/logo') %>
    </a>
  </div>
</header>

<% if (checkout.notice) { %>
<div class="border-b border-primary bg-primary-light px-6 py-3 text-center text-sm text-heading"><%= checkout.notice %></div>
<% } %>

<main class="lg:grid lg:grid-cols-2">

  <!-- ==================== CHECKOUT FORM ==================== -->
  <div class="px-6 py-10 sm:px-10 lg:px-16 lg:py-14">
    <div class="mx-auto max-w-[500px] lg:mx-0 lg:ml-auto">

      <%# ONE form for the whole checkout. Each sub-action (plan switch, promo apply/remove, bump) is a
          submit button that redirects it with `formaction`, so it posts exactly what is in the boxes
          right now, with no script involved ([27.10], [8.7]). They used to be sibling forms posting
          only their own field, and every one of them overwrote the buyer's stored details with
          blanks (lamp's checkout.twig made the same move). %>
      <form id="checkout-form" data-checkout-form method="post" action="<%= url('/checkout') %>" novalidate>
        <% if (csrf_token) { %><input type="hidden" name="_csrf" value="<%= csrf_token %>" /><% } %>

        <%# Pressing Enter in a text field submits a form's *first* submit button, wherever the cursor
            is. Every sub-action below (plan, bump, promo) is a submit button of this one form, so
            without this the first of them, or Pay Now, would answer Enter. This button is first in
            tree order: with discount codes it applies the code (Enter in the discount box does what
            the buyer meant, and an empty box sends nothing, see checkout.js); without them it is
            disabled, and a disabled default button means Enter submits nothing at all. Either way no
            keystroke can place an order: paying is only ever a click on Pay Now. %>
        <% if (checkout.capabilities.supportsPromotions) { %>
        <button type="submit" formaction="<%= url('/checkout/promo') %>" data-promo-apply data-default-guard class="sr-only" tabindex="-1" aria-hidden="true">Apply discount code</button>
        <% } else { %>
        <button type="submit" disabled data-default-guard class="hidden" tabindex="-1" aria-hidden="true"></button>
        <% } %>

        <h2 class="font-heading text-base font-bold sm:text-lg text-heading">Contact</h2>
        <div class="mt-4 flex flex-col gap-4">
          <div>
            <label for="checkout-email" class="mb-1 block text-sm text-muted">Email</label>
            <input type="email" id="checkout-email" name="email" value="<%= prefill.email || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('email') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
            <% if (fieldError('email')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('email') %></p><% } %>
          </div>
          <div>
            <label for="checkout-phone" class="mb-1 block text-sm text-muted">Phone</label>
            <input type="tel" id="checkout-phone" name="phone" value="<%= prefill.phone || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('phone') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
            <% if (fieldError('phone')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('phone') %></p><% } %>
          </div>
        </div>

        <h2 class="mt-8 font-heading text-base font-bold sm:text-lg text-heading">Delivery</h2>
        <div class="mt-4 flex flex-col gap-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="checkout-first-name" class="mb-1 block text-sm text-muted">First name</label>
              <input type="text" id="checkout-first-name" name="first_name" value="<%= prefill.first_name || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('first_name') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
              <% if (fieldError('first_name')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('first_name') %></p><% } %>
            </div>
            <div>
              <label for="checkout-last-name" class="mb-1 block text-sm text-muted">Last name</label>
              <input type="text" id="checkout-last-name" name="last_name" value="<%= prefill.last_name || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('last_name') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
              <% if (fieldError('last_name')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('last_name') %></p><% } %>
            </div>
          </div>

          <%# Suggestions are an enhancement `address-autocomplete.js` adds: from Google when the deployment has a Maps key, from the storefront's own endpoint otherwise. Picking one fills city, state and ZIP as well. With the script absent this is a plain text field. %>
          <div class="relative">
            <label for="checkout-address" class="mb-1 block text-sm text-muted">Address</label>
            <input type="text" id="checkout-address" name="address_line" value="<%= prefill.address_line || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('address_line') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading"<% if (addressAutocomplete) { %> data-address-autocomplete="<%= addressAutocomplete %>" data-suggest-url="<%= url('/checkout/address/suggest') %>" data-resolve-url="<%= url('/checkout/address/resolve') %>"<% if (addressAutocomplete === 'google') { %> data-maps-key="<%= maps_api_key %>"<% } %><% } %> />
            <% if (addressAutocomplete) { %>
            <ul id="checkout-address-suggestions" role="listbox" aria-label="Address suggestions" hidden class="absolute inset-x-0 top-[4.5rem] z-20 mt-1 max-h-72 overflow-y-auto rounded-sm border border-border bg-background py-1 shadow-lg"></ul>
            <% } %>
            <% if (fieldError('address_line')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('address_line') %></p><% } %>
          </div>

          <div>
            <label for="checkout-city" class="mb-1 block text-sm text-muted">City</label>
            <input type="text" id="checkout-city" name="city" value="<%= prefill.city || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('city') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
            <% if (fieldError('city')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('city') %></p><% } %>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="checkout-state" class="mb-1 block text-sm text-muted">State</label>
              <input type="text" id="checkout-state" name="territory" maxlength="2" value="<%= prefill.territory || '' %>" placeholder="NY" class="h-12 w-full rounded-sm border <%= fieldError('territory') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm uppercase text-heading" />
              <% if (fieldError('territory')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('territory') %></p><% } %>
            </div>
            <div>
              <label for="checkout-postal" class="mb-1 block text-sm text-muted">Postal code</label>
              <input type="text" id="checkout-postal" name="postal_code" value="<%= prefill.postal_code || '' %>" class="h-12 w-full rounded-sm border <%= fieldError('postal_code') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
              <% if (fieldError('postal_code')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('postal_code') %></p><% } %>
            </div>
          </div>
        </div>

        <%# Billing address. Unticked, billing is the delivery address above ([13.2]). The fields show
            and hide on `:has()` rather than a script, so the page still works with no JavaScript. They
            stay in the form while hidden, and the server reads them only when the box is ticked. %>
        <div class="group mt-8">
          <h2 class="font-heading text-base font-bold sm:text-lg text-heading">Billing address</h2>
          <label class="mt-4 flex cursor-pointer items-center gap-3">
            <input type="checkbox" id="checkout-billing-different" name="billing_different" value="on"<%= prefill.billing_different === 'on' ? ' checked' : '' %> />
            <span class="text-sm text-body">Use a different billing address</span>
          </label>

          <div id="checkout-billing-fields" class="mt-4 hidden flex-col gap-4 group-has-[#checkout-billing-different:checked]:flex">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="checkout-billing-first-name" class="mb-1 block text-sm text-muted">Billing first name</label>
                <input type="text" id="checkout-billing-first-name" name="billing_first_name" value="<%= prefill.billing_first_name || '' %>" autocomplete="billing given-name" class="h-12 w-full rounded-sm border <%= fieldError('billing_first_name') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
                <% if (fieldError('billing_first_name')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('billing_first_name') %></p><% } %>
              </div>
              <div>
                <label for="checkout-billing-last-name" class="mb-1 block text-sm text-muted">Billing last name</label>
                <input type="text" id="checkout-billing-last-name" name="billing_last_name" value="<%= prefill.billing_last_name || '' %>" autocomplete="billing family-name" class="h-12 w-full rounded-sm border <%= fieldError('billing_last_name') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
                <% if (fieldError('billing_last_name')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('billing_last_name') %></p><% } %>
              </div>
            </div>

            <div>
              <label for="checkout-billing-address" class="mb-1 block text-sm text-muted">Billing address</label>
              <input type="text" id="checkout-billing-address" name="billing_address_line" value="<%= prefill.billing_address_line || '' %>" autocomplete="billing street-address" class="h-12 w-full rounded-sm border <%= fieldError('billing_address_line') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
              <% if (fieldError('billing_address_line')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('billing_address_line') %></p><% } %>
            </div>

            <div>
              <label for="checkout-billing-city" class="mb-1 block text-sm text-muted">Billing city</label>
              <input type="text" id="checkout-billing-city" name="billing_city" value="<%= prefill.billing_city || '' %>" autocomplete="billing address-level2" class="h-12 w-full rounded-sm border <%= fieldError('billing_city') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
              <% if (fieldError('billing_city')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('billing_city') %></p><% } %>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="checkout-billing-state" class="mb-1 block text-sm text-muted">Billing state</label>
                <input type="text" id="checkout-billing-state" name="billing_territory" maxlength="2" placeholder="NY" value="<%= prefill.billing_territory || '' %>" autocomplete="billing address-level1" class="h-12 w-full rounded-sm border <%= fieldError('billing_territory') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm uppercase text-heading" />
                <% if (fieldError('billing_territory')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('billing_territory') %></p><% } %>
              </div>
              <div>
                <label for="checkout-billing-postal" class="mb-1 block text-sm text-muted">Billing postal code</label>
                <input type="text" id="checkout-billing-postal" name="billing_postal_code" value="<%= prefill.billing_postal_code || '' %>" autocomplete="billing postal-code" class="h-12 w-full rounded-sm border <%= fieldError('billing_postal_code') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
                <% if (fieldError('billing_postal_code')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('billing_postal_code') %></p><% } %>
              </div>
            </div>
          </div>
        </div>

        <% checkout.planChoices.forEach(function (plans, planIndex) { %>
        <h2 class="<%= planIndex === 0 ? 'mt-8' : 'mt-6' %> font-heading text-base font-bold sm:text-lg text-heading">Select Treatment Plan</h2>
        <p class="mt-0.5 text-xs text-muted"><%= plans.name %></p>
        <div class="mt-3.5 flex flex-col gap-2 rounded-md border border-border bg-background overflow-hidden">
          <% /* Each option is a submit button of the checkout form that names its own prescription as
                 `plan[slug]`, so with several in the order only the option actually clicked is posted,
                 it says which line it belongs to, and everything typed above goes with it. */ %>
          <% plans.options.forEach(function (option) { %>
          <button type="submit" formaction="<%= url('/checkout/plan') %>" name="plan[<%= plans.slug %>]" value="<%= option.id %>" aria-pressed="<%= option.id === plans.chosen ? 'true' : 'false' %>" class="group flex w-full cursor-pointer items-center justify-between gap-3 border border-transparent p-3 text-left aria-pressed:border-primary aria-pressed:bg-primary-light">
            <span class="flex items-center gap-3">
              <span class="flex size-4 shrink-0 items-center justify-center rounded-full border border-border-darker bg-background group-aria-pressed:border-primary">
                <span class="hidden size-2 rounded-full bg-primary group-aria-pressed:block"></span>
              </span>
              <span>
                <span class="block text-sm font-semibold text-heading"><%= option.name %></span>
                <span class="mt-1 block text-sm text-muted"><%= option.subscription ? 'Subscription' : 'Billed once' %></span>
              </span>
            </span>
            <span class="shrink-0 text-sm font-semibold text-heading"><%= money(option.price_cents) %></span>
          </button>
          <% }) %>
        </div>
        <% }) %>

        <%# Subscription selector: the plans the chosen variant is sold on, under the variant picker so
            the dose is chosen first. Each button names its own line as `subscription[slug]`, as the
            variant picker's do. The price is the plan's first payment: what this order charges, not
            what it renews at. %>
        <% if (checkout.subscriptionChoices.length > 0) { %>
        <h2 class="mt-8 font-heading text-base font-bold sm:text-lg text-heading">Select Subscription</h2>
        <% checkout.subscriptionChoices.forEach(function (subscription, subscriptionIndex) { %>
        <p class="<%= subscriptionIndex === 0 ? 'mt-0.5' : 'mt-6' %> text-xs text-muted"><%= subscription.name %><% if (subscription.variant_name) { %> · <%= subscription.variant_name %><% } %></p>
        <div class="mt-3.5 flex flex-col gap-2 rounded-md border border-border bg-background overflow-hidden">
          <% subscription.options.forEach(function (option) { %>
          <button type="submit" formaction="<%= url('/checkout/subscription') %>" name="subscription[<%= subscription.slug %>]" value="<%= option.id %>" aria-pressed="<%= option.id === subscription.chosen ? 'true' : 'false' %>" class="group flex w-full cursor-pointer items-center justify-between gap-3 border border-transparent p-3 text-left aria-pressed:border-primary aria-pressed:bg-primary-light">
            <span class="flex items-start gap-3">
                <span class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full border border-border-darker bg-background group-aria-pressed:border-primary">
                  <span class="hidden size-2 rounded-full bg-primary group-aria-pressed:block"></span>
                </span>
              <span>
                <span class="block text-sm font-semibold text-heading"><%= option.name %></span>
                <span class="mt-1 block text-sm text-muted"><%= option.description || 'Subscription' %></span>
              </span>
            </span>
            <span class="shrink-0 text-sm font-semibold text-heading"><%= money(option.price_cents) %></span>
          </button>
          <% }) %>
        </div>
        <% }) %>
        <% } %>

        <% if (checkout.postCheckoutSteps) { %>
        <%- include('../partials/post-checkout-steps', { note_class: 'mt-6' }) %>
        <% } %>

        <% if (checkout.bumps.length > 0) { %>
        <h2 class="mt-8 font-heading text-base font-bold sm:text-lg text-heading">Add to your order</h2>
        <div class="mt-3.5 flex flex-col gap-3">
          <% checkout.bumps.forEach(function (bump) { %>
          <div class="flex items-center gap-3 rounded-md border border-border p-3">
            <% if (bump.image) { %><img src="<%= bump.image %>" alt="" class="size-14 shrink-0 rounded-sm object-cover" />
            <% } else { %><span class="flex size-14 shrink-0 items-center justify-center rounded-sm bg-surface"><i data-lucide="plus-circle" class="size-6 text-icon-muted"></i></span><% } %>
            <div class="flex-1">
              <p class="text-sm font-semibold text-heading"><%= bump.headline %></p>
              <% if (bump.body) { %><p class="mt-0.5 text-sm text-muted"><%= bump.body %></p><% } %>
              <p class="mt-1 text-sm font-medium text-heading">
                <%= money(bump.price_cents) %>
                <% if (bump.discounted) { %><span class="ml-1 text-xs text-muted line-through"><%= money(bump.catalog_price_cents) %></span><% } %>
              </p>
            </div>
            <button type="submit" formaction="<%= url('/checkout/bump') %>" name="bump_slug" value="<%= bump.slug %>" class="shrink-0 rounded-sm border border-border bg-background px-5 py-2 text-sm font-medium text-heading transition-colors hover:border-primary hover:text-primary">Add</button>
          </div>
          <% }) %>
        </div>
        <% } %>

        <% if (checkout.capabilities.supportsPromotions) { %>
        <div class="mt-8 flex flex-col gap-2">
          <label for="checkout-discount" class="sr-only">Discount code</label>
          <div class="flex gap-3">
            <input type="text" id="checkout-discount" placeholder="Discount code" class="h-12 min-w-0 flex-1 rounded-sm border border-border bg-background px-4 text-sm text-heading" name="discount_code" />
            <button type="submit" formaction="<%= url('/checkout/promo') %>" data-promo-apply class="flex h-12 shrink-0 items-center justify-center rounded-sm border border-border bg-background px-6 text-sm font-medium text-heading hover:border-primary hover:text-primary">Apply</button>
          </div>
          <% if (checkout.promotion) { %>
          <div class="flex items-center justify-between text-sm text-heading">
            <span>Code <strong><%= checkout.promotion.code %></strong> applied</span>
            <button type="submit" formaction="<%= url('/checkout/promo/remove') %>" class="text-primary underline">Remove</button>
          </div>
          <% } %>
        </div>
        <% } %>

        <% if (checkout.capabilities.rendersOwnCardFields()) { %>
        <h2 class="mt-8 font-heading text-base font-bold sm:text-lg text-heading">Payment</h2>
        <p class="mt-1 text-sm text-muted">All transactions are secure and encrypted.</p>
        <div class="mt-3.5 flex flex-col gap-4 rounded-md border border-border bg-background-2 px-5 py-5">
          <div>
            <label for="checkout-card-number" class="mb-1 block text-sm text-muted">Card number</label>
            <input type="text" id="checkout-card-number" name="card_number" inputmode="numeric" autocomplete="cc-number" maxlength="23" class="h-12 w-full rounded-sm border <%= fieldError('card_number') ? 'border-danger' : 'border-border' %> bg-background px-4 text-sm text-heading" />
            <% if (fieldError('card_number')) { %><p class="mt-1 text-sm text-danger"><%= fieldError('card_number') %></p><% } %>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="checkout-card-expiry" class="mb-1 block text-sm text-muted">Expiration date (MM / YY)</label>
              <input type="text" id="checkout-card-expiry" name="card_expiry" inputmode="numeric" autocomplete="cc-exp" maxlength="7" placeholder="MM / YY" class="h-12 w-full rounded-sm border border-border bg-background px-4 text-sm text-heading" />
            </div>
            <div>
              <label for="checkout-card-cvc" class="mb-1 block text-sm text-muted">Security code</label>
              <input type="text" id="checkout-card-cvc" name="card_cvc" inputmode="numeric" autocomplete="cc-csc" maxlength="4" class="h-12 w-full rounded-sm border border-border bg-background px-4 text-sm text-heading" />
            </div>
          </div>
        </div>
        <% } else { %>
        <h2 class="mt-8 font-heading text-base font-bold sm:text-lg text-heading">Payment</h2>
        <p class="mt-1 text-sm text-muted">All transactions are secure and encrypted.</p>
        <div class="mt-3.5 overflow-hidden rounded-md border border-border bg-background p-5" data-payment-surface>
          <%# The provider hosts its own card fields. Nothing of the card is ours to render, to name, or to see.
              The provider's script mounts them here from the public configuration the adapter declares, and
              posts back a token in `payment_token` instead of a card ([15.1], [15.4c]).
              `data-challenge` is present only while the buyer's bank is waiting for them to verify the payment
              ([14.22]); it is what the provider's script needs to run that step, so it is rendered into this
              page and nowhere else. %>
          <div id="payment-provider-surface"
            data-provider="<%= checkout.capabilities.providerCategory %>"
            data-client-config="<%= JSON.stringify(clientConfig) %>"
            data-amount="<%= checkout.totals.totalCents %>"
            data-settlement="<%= checkout.settlement %>"
            data-currency="<%= String(checkout.currency).toLowerCase() %>"
            data-confirm-url="<%= url('/checkout/confirm/') %>"
            <% if (checkout.paymentChallenge) { %>data-challenge="<%= checkout.paymentChallenge %>"<% } %>></div>
          <input type="hidden" name="payment_token" value="" data-payment-token />
          <p data-payment-error role="alert" class="mt-3 hidden text-sm font-medium text-danger"></p>
          <% if (checkout.paymentChallenge) { %>
          <p class="mt-3 text-sm text-muted">Verification window not showing? <a href="<%= url('/checkout/confirm/') %>" class="font-medium text-primary underline">Check the payment again</a>.</p>
          <% } %>
          <noscript>
            <p class="text-sm text-muted">Your payment provider's secure card form needs JavaScript to load.</p>
          </noscript>
        </div>
        <% } %>

        <div class="mt-6 flex flex-col gap-4">
          <% checkout.consents.forEach(function (consent) { %>
          <label class="flex cursor-pointer items-start gap-3 rounded-md border <%= fieldError(consent.key) ? 'border-danger' : 'border-border' %> px-5 py-4">
            <input type="checkbox" name="consents[<%= consent.key %>]" value="1" class="mt-0.5" />
            <span class="text-sm text-body"><%- consent.html %></span>
          </label>
          <% if (fieldError(consent.key)) { %><p class="text-sm text-danger"><%= fieldError(consent.key) %></p><% } %>
          <% }) %>
        </div>

        <button type="submit" data-checkout-submit data-busy-label="Processing…" class="mt-6 flex h-11 w-full items-center justify-center rounded-sm bg-primary px-5 text-base font-medium text-primary-foreground transition-colors hover:bg-primary-hover">
          Pay Now
        </button>
      </form>

    </div>
  </div>

  <!-- ==================== ORDER SUMMARY ==================== -->
  <div class="border-border bg-background-2 px-6 py-10 sm:px-10 lg:border-l lg:px-12 lg:py-14">
    <div class="mx-auto max-w-[410px] lg:mx-0 lg:sticky lg:top-10">
      <h2 class="font-heading text-base font-bold sm:text-lg text-heading">Order Summary</h2>

      <div class="mt-6 flex flex-col gap-4">
        <% checkout.lines.forEach(function (line) { %>
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            <% if (line.image) { %><img src="<%= line.image %>" alt="<%= line.name %>" class="size-14 rounded-sm object-cover" />
            <% } else { %><span class="flex size-14 items-center justify-center rounded-sm bg-surface"><i data-lucide="pill" class="size-6 text-icon-muted"></i></span><% } %>
            <span class="absolute -right-1.5 -top-1.5 flex size-5 items-center justify-center rounded-full bg-heading text-xs font-medium text-background"><%= line.quantity %></span>
          </div>
          <div class="flex-1">
            <p class="text-sm text-heading"><%= line.name %></p>
            <% if (line.variant_name) { %><p class="mt-0.5 text-sm text-muted"><%= line.variant_name %></p><% } %>
          </div>
          <p class="shrink-0 text-base font-medium text-heading"><%= line.is_free ? 'Free' : money(line.line_total_cents) %></p>
          <%# Remove: a sub-action of the checkout form (this column sits outside it, hence `form=`), so
              what the buyer typed is posted and kept. An attachment the cart added for another line
              has none: it goes with that line. %>
          <% if (!line.is_child) { %>
          <button type="submit" form="checkout-form" formaction="<%= url('/checkout/remove') %>" name="remove_slug" value="<%= line.slug %>" class="shrink-0 text-body transition-colors hover:text-danger" aria-label="Remove <%= line.name %> from your order">
            <i data-lucide="trash-2" class="size-4"></i>
          </button>
          <% } %>
        </div>
        <% }) %>
      </div>

      <div class="mt-6 flex flex-col gap-2 border-t border-border pt-6 text-[14px] text-heading">
        <div class="flex items-center justify-between">
          <span>Subtotal &bull; <%= checkout.itemCount %> item<%= checkout.itemCount === 1 ? '' : 's' %></span>
          <span><%= money(checkout.totals.subtotalCents) %></span>
        </div>
        <% if (checkout.totals.discountCents > 0) { %>
        <div class="flex items-center justify-between text-primary">
          <span>Discount</span>
          <span>&minus;<%= money(checkout.totals.discountCents) %></span>
        </div>
        <% } %>
      </div>
      <div class="mt-4 flex items-center justify-between border-t border-border pt-4">
        <span class="text-base font-medium sm:text-lg text-heading">Total</span>
        <span class="text-base font-medium sm:text-lg text-heading"><span class="mr-1 text-sm font-normal text-muted align-middle"><%= checkout.currency %></span><%= money(checkout.totals.totalCents) %></span>
      </div>

      <%# Only a subscription whose plan takes its first payment at once is told it is charged today;
          every other order on a provider that can hold keeps the hold notice. %>
      <% if (checkout.paymentNotice === 'charge') { %>
      <div class="mt-6 flex items-start gap-3 rounded-sm border border-primary bg-primary-light px-4 py-4">
        <i data-lucide="info" class="mt-0.5 size-5 shrink-0 text-primary"></i>
        <p class="text-sm leading-relaxed text-heading">Your card will be charged today for the first payment of your subscription.</p>
      </div>
      <% } else if (checkout.capabilities.supportsAuthorizeCapture) { %>
      <div class="mt-6 flex items-start gap-3 rounded-sm border border-primary bg-primary-light px-4 py-4">
        <i data-lucide="info" class="mt-0.5 size-5 shrink-0 text-primary"></i>
        <p class="text-sm leading-relaxed text-heading">Payment authorization will be held; you will only be charged if approved and prescribed by a doctor.</p>
      </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer-compliance') %>
<%- include('../partials/foot', { scripts }) %>
