<%
/* Ported from storefront-lamp/theme/templates/pages/legal/terms.twig. Placeholder legal copy — this
   page exists because the checkout consent controls link to it, and a consent whose document
   cannot be opened is not consent at all (`[26.9]`). The wording below is deliberately not legal
   text — jurisdiction and counsel differ, and every deployment is responsible for its own. */
const pageDescription = 'Terms of Service for ' + site.name + '.';
%>
<%- include('../../partials/head', { page_title: 'Terms of Service', page_description: pageDescription }) %>
<%- include('../../partials/header') %>
<%- include('../../partials/cart-notice') %>

<main>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:px-10 sm:py-24">
    <h1 class="font-heading text-3xl font-bold text-heading sm:text-4xl">Terms of Service</h1>

    <p role="note" class="mt-8 rounded-sm border border-danger bg-background px-5 py-4 text-sm font-medium text-danger">
      This page is placeholder text and is not legal advice. This deployment must
      replace it with its own Terms of Service before taking real orders.
    </p>

    <div class="mt-8 flex flex-col gap-4 text-base text-body">
      <p>
        This document would set out the agreement between this practice and the patient. It is linked from the consent
        controls on the checkout page, so a buyer is asked to agree to it before
        an order can be placed.
      </p>
      <p>
        The consent wording itself lives in <code>config/consent.ts</code>, and the
        exact text shown to each buyer is stored with their order — so a record can
        always reproduce what was agreed to, rather than pointing at whatever this
        page happens to say later.
      </p>
    </div>
  </section>
</main>

<%- include('../../partials/footer') %>
<%- include('../../partials/foot') %>
