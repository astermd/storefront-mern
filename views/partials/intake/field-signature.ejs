<%- /*
  Ported from storefront-lamp/theme/templates/partials/intake/field-signature.twig. A drawn
  signature. The pad is drawn on with a finger, a pen or a mouse (public/js/intake-files.js), and
  the drawing is kept as a PNG data URL in the hidden input, which is what the form posts: a
  signature is small enough to travel in the answer itself, and is never uploaded as a file.

  The hidden input comes first because the stepper reads a field's first control as its answer. A
  signature already given is drawn back onto the pad from that input when the page loads.
*/ '' %>
<label class="block text-sm font-medium text-heading" id="intake-<%= f.name %>-label">
  <%= f.label %><% if (f.required) { %> <span class="text-danger">*</span><% } %>
</label>
<% if (f.description) { %><p class="mt-1 text-sm text-muted"><%= f.description %></p><% } %>
<div class="mt-2" data-intake-signature>
  <input type="hidden" name="<%= f.name %>" value="<%= f.value %>" data-intake-signature-value />
  <canvas data-intake-signature-pad
          width="<%= f.signature.width %>" height="<%= f.signature.height %>"
          style="aspect-ratio: <%= f.signature.width %> / <%= f.signature.height %>; max-width: <%= f.signature.width %>px"
          role="img" aria-labelledby="intake-<%= f.name %>-label"
          class="block w-full touch-none rounded-sm border-2 border-border bg-white aria-[invalid=true]:border-danger<% if (f.disabled) { %> pointer-events-none opacity-60<% } %>"
          <% if (f.error) { %>aria-invalid="true" aria-describedby="<%= f.error_id %>"<% } %>></canvas>
  <div class="mt-2 flex items-center justify-between gap-4" style="max-width: <%= f.signature.width %>px">
    <span class="text-xs text-muted">Sign inside the box.</span>
    <button type="button" data-intake-signature-clear
            class="rounded-sm px-2 py-1 text-xs font-medium text-body underline transition-colors hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">Clear</button>
  </div>
</div>
<%- include('field-error', { f }) %>
