<!-- The stored/typed shape is MM/DD/YYYY (month first — see DateAnswer's doc comment); this
     control collects and re-displays exactly that, converting to the EMR's YYYY-MM-DD only at the
     AnswerEncoder/RecordMapper boundary, never here.
     The markup contract public/js/datepicker.js documents: without the panel and its days grid the
     script returns before binding anything, leaving a plain text box with a calendar icon that
     does nothing. -->
<label class="block text-sm font-medium text-heading" for="field-<%= f.name %>">
  <%= f.label %><% if (f.required) { %> <span class="text-danger">*</span><% } %>
</label>
<% if (f.description) { %><p class="mt-1 text-sm text-muted"><%= f.description %></p><% } %>
<div class="mt-2" data-datepicker>
  <div class="relative">
    <input
      type="text"
      id="field-<%= f.name %>"
      name="<%= f.name %>"
      value="<%= f.value %>"
      placeholder="MM / DD / YYYY"
      inputmode="numeric"
      autocomplete="off"
      data-datepicker-input
      <% if (f.required) { %>required<% } %>
      <% if (f.readonly) { %>readonly<% } %>
      <% if (f.disabled) { %>disabled<% } %>
      <% if (f.error) { %>aria-invalid="true" aria-describedby="<%= f.error_id %>"<% } %>
      class="block w-full rounded-sm border <%= f.error ? 'border-danger' : 'border-border' %> px-3 py-2 pr-11 text-base text-body focus:border-primary focus:outline-none"
    />
    <button type="button" data-datepicker-toggle aria-label="Open calendar" aria-expanded="false" <% if (f.disabled) { %>disabled<% } %> class="absolute right-3.5 top-1/2 -translate-y-1/2 text-icon-muted transition-colors hover:text-heading">
      <i data-lucide="calendar" class="size-4"></i>
    </button>
    <div data-datepicker-panel class="hidden absolute left-0 top-full z-20 mt-1 w-72 rounded-sm border border-border bg-background p-3 shadow-lg">
      <div class="mb-2 flex items-center justify-between">
        <button type="button" data-datepicker-prev aria-label="Previous month" class="flex size-8 items-center justify-center rounded-full text-heading transition-colors hover:bg-divider">&lsaquo;</button>
        <span data-datepicker-month-label class="text-sm font-medium text-heading" aria-live="polite"></span>
        <button type="button" data-datepicker-next aria-label="Next month" class="flex size-8 items-center justify-center rounded-full text-heading transition-colors hover:bg-divider">&rsaquo;</button>
      </div>
      <div class="grid grid-cols-7 text-center text-xs text-muted" aria-hidden="true">
        <% ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'].forEach(function (day) { %><span class="py-1"><%= day %></span><% }) %>
      </div>
      <div data-datepicker-days class="grid grid-cols-7 gap-y-1"></div>
      <div class="mt-2 flex items-center justify-between border-t border-divider pt-2 text-sm">
        <button type="button" data-datepicker-clear class="text-muted transition-colors hover:text-heading">Clear</button>
        <button type="button" data-datepicker-today class="font-medium text-primary transition-colors hover:text-heading">Today</button>
      </div>
    </div>
  </div>
  <%- include('field-error', { f }) %>
</div>
