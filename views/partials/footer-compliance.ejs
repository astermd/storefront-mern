<%- /* Ported from storefront-lamp/theme/templates/partials/footer-compliance.twig — a condensed
       footer used by non-marketing layouts (intake/funnel pages, Phase 6+). Not used by the
       marketing pages this phase builds; included now for reuse later. */ '' %>
<footer class="border-t border-border bg-background">
  <div class="mx-auto flex max-w-[1440px] flex-col items-center gap-6 px-6 py-8 lg:flex-row lg:justify-between lg:px-[120px]">
    <div class="text-center lg:text-left">
      <p class="text-sm text-muted">&copy; 2026 AsterMD. All Rights Reserved.</p>
      <p class="mt-2 flex items-center justify-center gap-1.5 text-sm text-muted lg:justify-start">
        <i data-lucide="lock" class="size-4"></i>
        Your data is secure and HIPAA-compliant.
      </p>
    </div>

    <img src="/assets/img/footer-badge-2.png" alt="LegitScript Certified" class="h-16 w-auto" />

    <div class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm text-body">
      <a href="<%= url('/terms') %>" class="underline transition-colors hover:text-primary">Terms of Service</a>
      <a href="<%= url('/privacy') %>" class="underline transition-colors hover:text-primary">Privacy Policy</a>
      <a href="#" class="underline transition-colors hover:text-primary">Refund Policy</a>
      <a href="<%= url('/telehealth-consent') %>" class="underline transition-colors hover:text-primary">HIPAA Compliance</a>
    </div>
  </div>
</footer>
