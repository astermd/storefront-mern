# Copy to .env for local development. Ported from storefront-lamp's environment variables —
# see config/app.ts for how each one is consumed. NODE_ENV replaces the PHP original's APP_ENV
# (see config/app.ts's doc comment for why).

NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Database — Prisma's own connection string, read directly by prisma/schema.prisma. The engine
# (sqlite here) is fixed in schema.prisma's datasource block, not chosen at runtime — see
# MERN.md's Persistence section for what switching engines costs under Prisma.
DATABASE_URL="file:../storage/database/app.sqlite3"

# Superseded by DATABASE_URL above (kept only because config/app.ts's `database` block still
# reads these for display/diagnostic purposes) — DB_DRIVER=sqlite | mysql | postgres
DB_DRIVER=sqlite
DB_DATABASE=storage/database/app.sqlite3
DB_HOST=127.0.0.1
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# EMR credentials — secrets, never committed with a real value. Read directly from process.env
# by src/emr/client-factory.ts (never through ConfigService), matching storefront-lamp's own
# core/Emr/ClientFactory.php.
ASTERMD_CLIENT_ID=
ASTERMD_CLIENT_SECRET=

# EMR channel binding — read by config/app.ts.
ASTERMD_BASE_HOST=api.astermd.com
ASTERMD_CHANNEL_ID=

# Patient portal — absent means every "manage your care" link renders as absent, not broken.
PATIENT_PORTAL_URL=

# app.session.analytics — gates the whole EMR gateway family (Session/Cart/Teleform/Intake/Lead)
# between real (Emr*Gateway, backed by @astermd-hq/sdk) and Null. Matches storefront-lamp exactly:
# no env knob for it — on everywhere except NODE_ENV=test, so the test suite never reaches the
# network (see config/app.ts).

# Attribution payload signing key(s) — see config/app.ts's `attribution` block.
AMD_TRACKING_KEY=
AMD_TRACKING_KEY_PREVIOUS=

GOOGLE_MAPS_API_KEY=

# app.features.emr_verification — gates EmrVerificationGateway (email/address aid). Null-only.
EMR_VERIFICATION=false

# verification.enabled — gates IdentityGateway (KYC checks at /verify/). Null-only; when true the
# Null implementation still only ever answers "inconclusive", never "passed".
VERIFICATION_ENABLED=false

# Never true in a deployment taking real payments — logs unredacted wire traffic. See
# config/app.ts's doc comment.
WIRE_LOG=false

SESSION_SECRET=change-me-in-every-real-environment
